{
  "name": "kakekomi-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kakekomi-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kakekomi-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260907.1": true
  }
}
